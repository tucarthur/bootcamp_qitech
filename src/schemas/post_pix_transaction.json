{
  "title": "PostPixTransaction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "transaction_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source_account": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "account_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "opening_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "pattern": "^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$"
            }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "participant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "account_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "opening_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "pattern": "^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$"
            }
          },
          "required": ["document_number"],
          "additionalProperties": false
        }
      },
      "required": ["participant", "branch", "account_number", "opening_date", "owner"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "ip": {
          "type": "string",
          "minLength": 3,
          "maxLength": 45
        },
        "geolocation": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": ["latitude", "longitude"],
          "additionalProperties": false
        }
      },
      "required": ["device_id", "channel", "ip", "geolocation"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account",
    "source"
  ],
  "additionalProperties": false
}
