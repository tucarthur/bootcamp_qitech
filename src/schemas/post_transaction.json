{
  "title": "PostTransaction",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_account_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "destination_account_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "amount_cents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    }
  },
  "required": [
    "idempotency_key",
    "source_account_key",
    "destination_account_key",
    "amount_cents"
  ],
  "additionalProperties": false
}